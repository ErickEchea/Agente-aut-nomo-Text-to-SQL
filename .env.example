# NEXUS AI — environment template.
# `make env` copies this file to .env and replaces every __GENERATE__ with a random secret.
# Never commit .env.

# --- Databases -------------------------------------------------------------------------------
# Superuser of the app database container (used only by its init script).
NEXUS_APP_DB_SUPERUSER_PASSWORD=__GENERATE__
# Password of `nexus_app`, the non-superuser role the API uses for the app database.
NEXUS_APP_DB_PASSWORD=__GENERATE__
# Superuser of the demo (retail) database container.
NEXUS_DEMO_DB_SUPERUSER_PASSWORD=__GENERATE__
# `retail_owner`: owns/loads the retail data. Used only by the demo-seed job.
NEXUS_DEMO_OWNER_PASSWORD=__GENERATE__
# `nexus_reader`: the agent's SELECT-only, read-only-by-default role.
NEXUS_DEMO_READER_PASSWORD=__GENERATE__

# --- Host ports (bound to 127.0.0.1 only) ----------------------------------------------------
NEXUS_APP_DB_PORT=55432
NEXUS_DEMO_DB_PORT=55433
NEXUS_API_PORT=8000
NEXUS_WEB_PORT=8080

# --- Models (ADR-0003). `make up` picks the GPU or CPU model automatically. -------------------
# GPU default is provisional until the Phase 6 benchmark selects it.
NEXUS_LLM_MODEL_GPU=qwen2.5-coder:7b
NEXUS_LLM_MODEL_CPU=qwen2.5-coder:3b
NEXUS_EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- Demo data (ADR-0017) --------------------------------------------------------------------
NEXUS_DEMO_SEED=20241101
NEXUS_DEMO_SCALE=1.0

# --- API -------------------------------------------------------------------------------------
NEXUS_ENV=production
NEXUS_LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins (no wildcards).
NEXUS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
