# NEXUS AI — environment template.
# `make env` copies this file to .env and replaces every __GENERATE__ with a random secret.
# Never commit .env.

# --- Databases -------------------------------------------------------------------------------
# Superuser of the app database container (used only by its init script).
NEXUS_APP_DB_SUPERUSER_PASSWORD=__GENERATE__
# Password of `nexus_app`, the non-superuser role the API uses for the app database.
NEXUS_APP_DB_PASSWORD=__GENERATE__
# Superuser of the demo (retail) database container.
NEXUS_DEMO_DB_SUPERUSER_PASSWORD=__GENERATE__
# `retail_owner`: owns/loads the retail data. Used only by the demo-seed job.
NEXUS_DEMO_OWNER_PASSWORD=__GENERATE__
# `nexus_reader`: the agent's SELECT-only, read-only-by-default role.
NEXUS_DEMO_READER_PASSWORD=__GENERATE__

# --- Host ports (bound to 127.0.0.1 only) ----------------------------------------------------
NEXUS_APP_DB_PORT=55432
NEXUS_DEMO_DB_PORT=55433
NEXUS_WEB_PORT=8080
NEXUS_OLLAMA_PORT=11435

# --- Models (ADR-0003). `make up` picks the GPU or CPU model automatically. -------------------
# GPU default chosen by the Phase 6 benchmark (ADR-0022, docs/benchmark.md).
NEXUS_LLM_MODEL_GPU=qwen2.5-coder:7b
NEXUS_LLM_MODEL_CPU=qwen2.5-coder:3b
NEXUS_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Reasoning toggle for models that think by default (qwen3, gemma4): false is faster and keeps the
# JSON outputs within their token budget. Empty = the model's own default.
NEXUS_LLM_THINK=
# Optional per-node routing (ADR-0003 §3): a model per agent node; empty = the default model above.
# List every routed model in NEXUS_LLM_EXTRA_MODELS (comma-separated) so ollama-init pulls it.
NEXUS_LLM_EXTRA_MODELS=
NEXUS_LLM_MODEL_UNDERSTAND=
NEXUS_LLM_MODEL_PLAN=
NEXUS_LLM_MODEL_GENERATE=
NEXUS_LLM_MODEL_REPAIR=
NEXUS_LLM_MODEL_VISUALIZE=
NEXUS_LLM_MODEL_EXPLAIN=

# --- Demo data (ADR-0017) --------------------------------------------------------------------
NEXUS_DEMO_SEED=20241101
NEXUS_DEMO_SCALE=1.0

# --- Security (ADR-0010) ---------------------------------------------------------------------
# Signs access tokens (>= 32 chars).
NEXUS_JWT_SECRET=__GENERATE__
# First administrator, created on first start if no admin exists. Sign in with these.
NEXUS_ADMIN_EMAIL=admin@nexus.local
NEXUS_ADMIN_PASSWORD=__GENERATE__
# Account used by the Playwright suite (`make e2e` creates it if missing, as an admin).
NEXUS_E2E_EMAIL=e2e@nexus.local
NEXUS_E2E_PASSWORD=__GENERATE__
# Password of the analyst accounts load-1..N@nexus.local that `make load` creates if missing.
NEXUS_LOAD_PASSWORD=__GENERATE__
# Encrypts credentials of registered data sources (Fernet, ADR-0012). Comma-separated: the first key
# encrypts, all keys decrypt (prepend a new key, run `make rotate-keys`, then drop the old one).
NEXUS_CREDENTIALS_KEYS=__GENERATE__
# Set true when served over HTTPS so the refresh cookie gets the Secure flag.
NEXUS_COOKIE_SECURE=false

# --- Agent ------------------------------------------------------------------------------------
# "Today" for relative dates. The demo data ends 2026-10-31 (ADR-0008). Empty = real today.
NEXUS_AGENT_AS_OF=2026-11-01
# Columns masked in results (table.column, comma-separated). Empty disables masking.
NEXUS_PII_COLUMNS=clientes.cedula,clientes.email,clientes.telefono,empleados.cedula

# --- API -------------------------------------------------------------------------------------
NEXUS_ENV=production
NEXUS_LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins (no wildcards).
NEXUS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
